{
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/alexta69/metube"],
      versioning: "loose"
    },
    {
      matchPackageNames: ["longhorn", "ghcr.io/home-operations/charts-mirror/longhorn"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
      automergeType: "pr"
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/plex"],
      automergeSchedule: ["after 3:00am and before 9:00am"],
    },
    {
      matchDatasources: [
        "github-tags",
      ],
      matchPackageNames: [
        "bitnami-labs/sealed-secrets",
      ],
      allowedVersions: "!/0.31.0/",
    },
    {
      // xpumd 2.4.0 renamed its gRPC API, which breaks intel-gpu-resource-driver <= 0.12.1
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/intel/xpumanager/charts/xpumd"],
      allowedVersions: "<2.4.0",
    }
  ]
}
